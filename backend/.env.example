# =============================================================================
# BUIDCO backend — configuration template.
#
# HOW TO USE:
#   Copy this file to `.env.local` and fill in real values there.
#   NEVER commit `.env.local` — it is gitignored.
#   NEVER put real secrets in THIS file — anything committed is public.
#   In production prefer the host's secret store / environment variables
#   over a file on disk.
#
# HOW TO GENERATE FRESH SECRETS:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================

# REQUIRED — the server refuses to start without it (no default).
#   production   any deployed server (set by the host or ecosystem.config.cjs)
#   development  local work; the npm scripts already load
#                backend/config/development.env, which sets it
#   test         set by vitest.config.ts
NODE_ENV=development
PORT=4000

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Keep TLS settings out of it and use DB_SSL.
DATABASE_URL=postgres://user:password@host:5432/dbname
# TLS to PostgreSQL:
#   off        plain TCP — only for a database on the same server / private link
#   verify     TLS with certificate and host-name verification (use for any
#              database reached over a network)
#   no-verify  TLS without verification — refused in production
# Unset = derived from the URL's sslmode (require/verify-full => verify).
DB_SSL=
# PEM file of the CA that signed the database certificate, if it is not a
# publicly trusted CA (e.g. a government or private CA).
DB_SSL_CA_FILE=

# --- Sessions ----------------------------------------------------------------
# JWT signing secrets — at least 32 characters each, DIFFERENT from each
# other and different in every environment (dev / staging / production).
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-base64
JWT_REFRESH_SECRET=replace-with-32-plus-char-random-base64
# Access token lifetime (seconds).
ACCESS_TOKEN_TTL_SECONDS=900
# Idle timeout: a session not refreshed for this long ends (default 2 hours).
REFRESH_TOKEN_TTL_SECONDS=7200
# Absolute session lifetime from sign-in, however active (default 12 hours).
# Confirm both values with the department's policy.
SESSION_MAX_AGE_SECONDS=43200

# Comma-separated list of origins that may call the API from a browser.
# In production this is the public HTTPS origin of the frontend, e.g.
#   https://<official-domain>
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Set only if API and SPA share the same parent domain and you
# want the refresh cookie shared across subdomains. Leave BLANK when the
# SPA and API are served from the same origin.
COOKIE_DOMAIN=

# --- Network -----------------------------------------------------------------
# Which proxies in front of the API may report the client IP
# (X-Forwarded-For). Prefer the proxy address: "loopback" when Nginx/Apache/
# IIS runs on the same server, or its IP/subnet. A hop count ("1") also works
# but lets a client that reaches Node directly spoof its IP. "true" is
# refused. Unset = 1 hop (a warning is logged in production).
TRUST_PROXY=

# --- Rate limiting -----------------------------------------------------------
# Where counters live:
#   postgres  this database (shared by all instances; run migrations first)
#             — recommended for government hosting
#   upstash   Upstash Redis REST (third-party service; needs the two
#             UPSTASH_* values below)
#   memory    this process only (single-instance deployments)
#   off       development/tests only — refused in production
# Unset = upstash if configured, else memory in production, else off.
RATE_LIMIT_STORE=
LOGIN_RATE_LIMIT_PER_USER=20
LOGIN_RATE_LIMIT_PER_IP=100
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Geo-photo uploads -------------------------------------------------------
#   local        files stored on this server under PHOTO_STORAGE_DIR and
#                served only through the API (recommended for government
#                hosting; include the directory in backups)
#   uploadthing  UploadThing CDN (third-party; needs UPLOADTHING_TOKEN)
#   off          no file upload (photos can still be added as links)
# Unset = uploadthing if UPLOADTHING_TOKEN is set, else off.
PHOTO_STORAGE=
PHOTO_STORAGE_DIR=
PHOTO_MAX_BYTES=3145728
UPLOADTHING_TOKEN=

# --- Password-reset e-mail ---------------------------------------------------
# SMTP for password-reset codes. Without it the reset endpoints answer 503;
# codes are never written to the log. For local testing use a local mail
# catcher (e.g. Mailpit). Codes are sent by e-mail only — the mobile (SMS)
# channel is withdrawn until an SMS gateway is approved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BUIDCO Portal <no-reply@buidco.in>"

# --- Demo accounts -----------------------------------------------------------
# The demo_* accounts (npm run db:seed-demo-roles) cannot sign in when
# NODE_ENV=production unless this is "true". NEVER set it on government
# hosting.
ALLOW_DEMO_ACCOUNTS=false
# Development only: password the demo seeder gives the demo_* accounts
# (12+ characters, unique to your database). The end-to-end tests read the
# same variable. Leave blank on servers.
DEMO_ACCOUNT_PASSWORD=

# --- Current (pre-government) hosting only -----------------------------------
# Self-ping that keeps a Render free-tier instance awake. Only active when
# the host injects RENDER_EXTERNAL_URL. Set to "off" on any always-on host.
KEEP_ALIVE=on

# --- Optional Hindi-search translation fallback ------------------------------
# Off by default. Enabling it sends search text to an external service; in
# production only the Government of India "bhashini" provider is accepted,
# and only after departmental approval.
SEARCH_TRANSLATION=off
SEARCH_TRANSLATION_PROVIDER=bhashini
SEARCH_TRANSLATION_API_KEY=
SEARCH_TRANSLATION_ENDPOINT=
