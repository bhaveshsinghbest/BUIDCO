# Render (and any other host) sets NODE_ENV=production for Node services.
# npm >=7 reads NODE_ENV=production as an implicit `--omit=dev`, which skips
# devDependencies — including `typescript` and every `@types/*` package. The
# build then fails with a wall of TS7016 ("Could not find a declaration file
# for module 'express'") and TS7006 ("Parameter 'req' implicitly has an 'any'
# type") because `tsc` sees plain JS packages with no declarations.
#
# `include` wins over `omit` no matter how omit was set, so this restores
# devDependencies at install time. The build is a compile step: it genuinely
# needs the toolchain. Only `dist/` is run in production, so nothing here
# leaks into the runtime.
include=dev
