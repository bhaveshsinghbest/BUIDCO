# Non-secret settings for LOCAL DEVELOPMENT only (security finding S-05).
#
# The npm scripts that run TypeScript directly (dev server, migrations,
# seeders, generators) load this file with Node's --env-file flag, so
# NODE_ENV is always set explicitly instead of defaulting. A value already
# present in the shell environment takes precedence over this file.
#
# Never put secrets here (this file is committed). DATABASE_URL, JWT secrets
# and every other credential belong in backend/.env.local, which is
# gitignored; see backend/.env.example.
#
# Other environments set NODE_ENV themselves:
#   test        vitest.config.ts (NODE_ENV=test)
#   production  the host environment or ecosystem.config.cjs (NODE_ENV=production)
NODE_ENV=development
